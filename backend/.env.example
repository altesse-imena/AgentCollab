# Which model provider to use: openai | anthropic | openai_compatible
AGENTCOLLAB_PROVIDER=openai

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# For openai_compatible (OpenRouter, Groq, Together, Ollama, ...):
# AGENTCOLLAB_BASE_URL=https://openrouter.ai/api/v1
# AGENTCOLLAB_API_KEY=

# Optional model overrides. Defaults: gpt-4.1 (openai), claude-opus-5-5 (anthropic)
# AGENTCOLLAB_MODEL=
# AGENTCOLLAB_MODEL_WRITER=
# AGENTCOLLAB_MODEL_REVIEWER=
# AGENTCOLLAB_MODEL_TESTER=
# AGENTCOLLAB_MODEL_SECURITY=

AGENTCOLLAB_RUN_BUDGET_USD=0.50

# SQLite works out of the box; switch to Postgres with `docker compose up -d db`
DATABASE_URL=sqlite:///./agentcollab.db
# DATABASE_URL=postgresql+psycopg://agentcollab:agentcollab@localhost:5433/agentcollab

# Cost optimizations (off by default so a baseline can be measured)
# AGENTCOLLAB_RESPONSE_CACHE=true
# Run these roles on a cheaper model (gpt-4.1-mini / claude-sonnet-5-5 by default)
# AGENTCOLLAB_LIGHT_ROLES=reviewer,security
# AGENTCOLLAB_LIGHT_MODEL=
